{
  "name": "martes-fc-web",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/bundle.mjs dev",
    "build": "tsc --noEmit && node scripts/bundle.mjs build",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:visual": "playwright test",
    "check:public": "node scripts/check-public.mjs",
    "check:design": "node scripts/check-design-system.mjs",
    "typecheck:worker": "tsc -p ../worker/tsconfig.json",
    "test:worker": "node --test ../worker/tests/*.test.ts",
    "check:d1": "node scripts/check-d1-config.mjs",
    "check:no-picomatch": "node scripts/check-no-picomatch.mjs",
    "bench:stats": "node scripts/bench-stats.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "typescript": "~5.9.2",
    "esbuild": "0.25.12"
  }
}
