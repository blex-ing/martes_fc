{
  "name": "martes-fc",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "main": "./worker/index.ts",
  "keep_vars": true
}
